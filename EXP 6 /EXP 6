#include <LiquidCrystal.h>

// Initialize the library with the numbers of the interface pins
// LiquidCrystal(RS, Enable, D4, D5, D6, D7)
LiquidCrystal lcd(12, 11, 5, 4, 3, 2);

void setup() {
  // Set up the LCD's number of columns and rows:
  lcd.begin(16, 2);
}

void loop() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Hello");
  delay(1000);
  
  lcd.setCursor(0, 1);
  lcd.print("CS01 here!");
  delay(1000);
}
