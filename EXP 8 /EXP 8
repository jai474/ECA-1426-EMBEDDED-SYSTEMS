int mq6Pin = A0;

void setup() {
  pinMode(13, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  int sensorValue = analogRead(mq6Pin);

  Serial.print("MQ6 Sensor Value: ");
  Serial.println(sensorValue);

  if (sensorValue > 600) {
    digitalWrite(13, HIGH);
  } else {
    digitalWrite(13, LOW);
  }

  delay(100);
}
